# Copy to .env and fill in. Never commit .env.
# Leave the two Azure values empty to run in demo mode (bundled sample, no API calls).

# Azure AI Document Intelligence (Azure portal > your resource > Keys and Endpoint)
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# --- Optional ---
# Locale hint sent to Azure
DOCINTEL_LOCALE=it-IT
# Analyses kept in the history, per user
HISTORY_LIMIT=10
MAX_UPLOAD_MB=10
HISTORY_DB_PATH=history.db
# Comma-separated list; empty = any signed-in user (only used when Microsoft login is on)
ALLOWED_EMAILS=
