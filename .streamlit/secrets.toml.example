# Optional: Microsoft Entra ID login. Copy to .streamlit/secrets.toml (never commit it).
# Without an [auth] section the app runs without login.
# Docs: https://docs.streamlit.io/develop/concepts/connections/authentication

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # must match the app registration
cookie_secret = "<a long random string>"                # python -c "import secrets; print(secrets.token_hex(32))"
client_id = "<application (client) id>"
client_secret = "<client secret value>"
server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
